# GREENHAVEN TESTNET PREVIEW PROFILE — FEATURE-ENABLED TESTING OVERLAY
# Apply ONLY to Vercel Preview (and disposable local Testnet environments).
# This file contains no credentials. Supply real provider/database secrets separately.
# Never apply this profile to Vercel Production or a Mainnet deployment.

# Network identity: Pi Platform API production mode + Pi blockchain Testnet.
PI_ENV=production
PI_NETWORK=testnet
NEXT_PUBLIC_PI_SANDBOX=true
GHC_ENV=testnet
GHC_TESTNET_UNLOCK=1
NEXT_PUBLIC_GHC_TESTNET_UNLOCK=true

# Enable Pi purchase surfaces for Testnet. Provider credentials and database authority remain runtime prerequisites.
NEXT_PUBLIC_GHC_BUY_WITH_PI=true
NEXT_PUBLIC_GHC_BUY_WITH_PI_ENABLED=true
GHC_BUY_WITH_PI_ENABLED=true
GHC_PI_ONLY_COMMERCE=true

# Enable supported reward, referral and tip flows for Testnet; their server-side ledger/RPC checks remain mandatory.
GHC_REGISTRATION_BONUS_ENABLED=1
GHC_ACTIVITY_REWARDS_ENABLED=1
GHC_REFERRAL_SETTLEMENT_ENABLED=1
NEXT_PUBLIC_GHC_REFERRAL_SETTLEMENT_ENABLED=true
GHC_TIPS_ENABLED=true

# Enable the existing Testnet curation surface. The V2 settlement RPC remains held until its SQL proposal is applied and replay-tested.
GHC_CURATION_REDISTRIBUTE_ENABLED=1
NEXT_PUBLIC_GHC_CURATION_REDISTRIBUTE_ENABLED=true
# Held: V2 idempotency SQL proposal is not yet reconciled/applied/replay-tested; do not bypass this DB gate.
GHC_CURATION_REDISTRIBUTE_V2_ENABLED=false
# Held: durable per-reviewer daily-cap SQL is not applied/verified; GHPV settlement remains blocked.
GH_GHPV_CALIBRATION_DAILY_CAP_V2_ENABLED=false
# Held: RUN376 atomic allocator proposal is review-only and unapplied; DB-backed daily claims/activity issuance remain blocked.
GHC_ATOMIC_GLOBAL_EMISSION_V13_ENABLED=false

# Enable Pi Testnet payout request and operator-triggered execution. Credentials, wallet funding, consent, PIN proof, settlement and reconciliation remain runtime prerequisites.
PI_EARNINGS_ADAPTERS_ENABLED=true
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=true
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=true
PI_A2U_ENABLED=true
PI_A2U_TESTNET_ONLY=true
# Keep unattended/background payout execution off. Operator-triggered execution
# still requires a real Testnet API key, valid Testnet wallet seed, executor key,
# user wallet authorization, PIN proof and an owned eligible payout request.
PI_EARNINGS_AUTO_EXECUTE=false

# Enable GHC-to-Pi Testnet withdrawal requests using the codebase reference benchmark (100 GHC per Pi); this is a test reference, not a market/redemption quote.
GHC_WITHDRAWALS_ENABLED=true
GHC_WITHDRAWALS_TESTNET_ONLY=true
GHC_WITHDRAWAL_GHC_PER_PI=100

# Enable internal GHC marketplace payout requests. Paystack transfer route is enabled but requires an sk_test_ key; live transfers remain unapproved.
GHC_MARKETPLACE_GHC_PAYOUTS_ENABLED=true
PAYSTACK_TRANSFERS_ENABLED=true
PAYSTACK_LIVE_TRANSFERS_APPROVED=false
# Supply ONLY a Paystack test secret beginning sk_test_. The live-transfer approval flag remains false; never use sk_live_ here.
PAYSTACK_SECRET_KEY=

# Testnet E2E suites are enabled, but tests requiring real accounts skip until
# valid disposable Testnet session cookies and a Preview URL are supplied.
GHC_E2E_ALLOW_TESTNET=1
GHC_E2E_PI_TESTNET=1
GHC_E2E_PHASE4=1
GHC_E2E_PHASE5=1
GHC_E2E_BASE_URL=
GREENHAVEN_PREVIEW_URL=
GHC_E2E_COOKIE_A=
GHC_E2E_COOKIE_B=
GHC_E2E_AUTH_A=
GHC_E2E_AUTH_B=
GHC_E2E_CONVERSATION_ID=
GHC_E2E_MEDIA_URL=
GHC_E2E_PEER_USER_ID_B=
GHC_E2E_START_SERVER=0
GHC_E2E_TARGET=preview

# Required private provider credentials (populate only in Vercel Preview, branch testnet):
# DOMAIN_VALIDATION_KEY — exact Pi Developer Portal domain-validation string.
# PI_API_KEY — Testnet Pi Developer Portal API key; server-only.
# PI_WALLET_PRIVATE_SEED, PI_EARNINGS_EXECUTOR_KEY, PIN proof and Supabase service-role credentials
# are optional until the related payout/database workflow is explicitly approved.
# Provider/database credentials are deliberately NOT populated here.
DOMAIN_VALIDATION_KEY=
PI_API_KEY=
# Configure the required Supabase, Pi, webhook, operator and security secrets
# individually in Vercel Preview Environment Variables.
