# GREENHAVEN TESTNET PREVIEW PROFILE — CONNECTIVITY / AUTHENTICATION ONLY
# Apply ONLY to Vercel Preview for the Git branch `testnet` and disposable Testnet environments.
# This profile contains no credentials. Never apply it to Vercel Production or Mainnet.
# It deliberately keeps payments, payouts, withdrawals, rewards, curation settlement and
# other ledger-mutating features disabled until their separate release gates are approved.

# Network identity: Pi Platform API production mode + Pi blockchain Testnet.
PI_ENV=production
PI_NETWORK=testnet
NEXT_PUBLIC_PI_SANDBOX=true
GHC_ENV=testnet
GHC_TESTNET_UNLOCK=1
NEXT_PUBLIC_GHC_TESTNET_UNLOCK=true

# Pi authentication/connectivity only. These do not enable payment execution.
# NEXT_PUBLIC_PI_CLIENT_ID must match the Client ID of the GREENHAVEN Testnet app in Pi Portal.
# The value is provisioned in Vercel Preview; do not invent or commit it.

# Explicitly fail closed: Pi commerce and all ledger-mutating or money-moving features.
NEXT_PUBLIC_GHC_BUY_WITH_PI=false
NEXT_PUBLIC_GHC_BUY_WITH_PI_ENABLED=false
GHC_BUY_WITH_PI_ENABLED=false
GHC_REGISTRATION_BONUS_ENABLED=0
GHC_ACTIVITY_REWARDS_ENABLED=0
GHC_REFERRAL_SETTLEMENT_ENABLED=0
NEXT_PUBLIC_GHC_REFERRAL_SETTLEMENT_ENABLED=false
GHC_TIPS_ENABLED=false
GHC_CURATION_REDISTRIBUTE_ENABLED=0
NEXT_PUBLIC_GHC_CURATION_REDISTRIBUTE_ENABLED=false
GHC_CURATION_REDISTRIBUTE_V2_ENABLED=false
GH_GHPV_CALIBRATION_DAILY_CAP_V2_ENABLED=false
GHC_ATOMIC_GLOBAL_EMISSION_V13_ENABLED=false
PI_EARNINGS_ADAPTERS_ENABLED=false
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=false
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=false
PI_A2U_ENABLED=false
PI_A2U_TESTNET_ONLY=true
PI_EARNINGS_AUTO_EXECUTE=false
GHC_WITHDRAWALS_ENABLED=false
GHC_WITHDRAWALS_TESTNET_ONLY=true
GHC_WITHDRAWAL_GHC_PER_PI=100
GHC_MARKETPLACE_GHC_PAYOUTS_ENABLED=false
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_LIVE_TRANSFERS_APPROVED=false
PAYSTACK_SECRET_KEY=

# Testnet E2E scaffolding is opt-in and requires disposable accounts and real sessions.
GHC_E2E_ALLOW_TESTNET=1
GHC_E2E_PI_TESTNET=1
GHC_E2E_PHASE4=1
GHC_E2E_PHASE5=1
GHC_E2E_BASE_URL=
GREENHAVEN_PREVIEW_URL=
GHC_E2E_COOKIE_A=
GHC_E2E_COOKIE_B=
GHC_E2E_AUTH_A=
GHC_E2E_AUTH_B=
GHC_E2E_CONVERSATION_ID=
GHC_E2E_MEDIA_URL=
GHC_E2E_PEER_USER_ID_B=
GHC_E2E_START_SERVER=0
GHC_E2E_TARGET=preview

# Private provider credentials: configure only in Vercel Preview, branch `testnet`.
# DOMAIN_VALIDATION_KEY is the exact Pi Developer Portal domain-validation value.
# SUPABASE_SERVICE_ROLE_KEY is required for durable server-side identity/session persistence.
# PI_API_KEY is for server-side Pi Platform API operations that require the app API key;
# Pi /v2/me bearer-token verification itself must use the user's Pi access token.
# Never expose any of these as NEXT_PUBLIC_* or commit populated values.
DOMAIN_VALIDATION_KEY=
PI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
