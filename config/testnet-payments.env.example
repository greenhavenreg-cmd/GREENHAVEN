# GreenHaven Testnet payment/withdrawal activation profile.
# Copy these values ONLY into the Vercel Preview project/branch connected to Testnet.
# Never copy this profile into Vercel Production or a Mainnet deployment.
# Secrets intentionally remain blank; add only real Testnet/test-provider credentials.
#
# Vercel notes:
# - Set these in the Preview environment (VERCEL_ENV=preview). The code fails closed when
#   VERCEL_ENV=production, so withdrawals, bonus and unlock stay off there by design.
# - NEXT_PUBLIC_* values are inlined at build time. Redeploy after changing them.
# - Flags marked "exactly true" are compared to the string "true"; 1/yes/on will NOT enable them.

GHC_ENV=testnet
GHC_TESTNET_UNLOCK=1
NEXT_PUBLIC_GHC_TESTNET_UNLOCK=true
GHC_BUY_WITH_PI_ENABLED=true
NEXT_PUBLIC_GHC_BUY_WITH_PI_ENABLED=true
GHC_TIPS_ENABLED=true
GHC_REFERRAL_SETTLEMENT_ENABLED=1
NEXT_PUBLIC_GHC_REFERRAL_SETTLEMENT_ENABLED=true
GHC_ACTIVITY_REWARDS_ENABLED=1
GHC_REGISTRATION_BONUS_ENABLED=1
GHC_CURATION_REDISTRIBUTE_ENABLED=1
NEXT_PUBLIC_GHC_CURATION_REDISTRIBUTE_ENABLED=true
PI_NETWORK=testnet
NEXT_PUBLIC_PI_SANDBOX=true
PI_ENV=production

# Pi user-to-app and app-to-user payment paths.
PI_A2U_TESTNET_ONLY=true
PI_A2U_ENABLED=true
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=true
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=true
PI_EARNINGS_AUTO_EXECUTE=true
# Reward-source adapters (referral, activity_reward, community, promotion, utility, system,
# creator_earning) deny every credit unless this is exactly true on Testnet.
PI_EARNINGS_ADAPTERS_ENABLED=true
PI_EARNINGS_EXECUTOR_KEY=
PI_API_KEY=
PI_SERVER_API_KEY=
PI_WALLET_PRIVATE_SEED=
# Canonical server-only withdrawal PIN proof HMAC key (minimum 32 characters).
GH_PIN_PROOF_SECRET=

# GHC-to-Pi withdrawals and marketplace seller settlement.
GHC_WITHDRAWALS_ENABLED=true
GHC_MARKETPLACE_GHC_PAYOUTS_ENABLED=true
GHC_MARKETPLACE_PAYOUT_TREASURY_USER_ID=
GHC_PAYOUT_RECONCILIATION_KEY=
# Optional: GHC per 1 Pi. Blank falls back to the built-in reference rate.
GHC_WITHDRAWAL_GHC_PER_PI=
# Comma-separated user ids allowed to use /api/economy/withdrawals/operator.
GH_WITHDRAWAL_OPERATOR_IDS=

# NGN bank transfers: enabled only with a Paystack TEST secret.
# The application rejects sk_live_* keys whenever PI_NETWORK=testnet.
PAYSTACK_TRANSFERS_ENABLED=true
PAYSTACK_LIVE_TRANSFERS_APPROVED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_MAX_TRANSFER_KOBO=
PAYSTACK_DAILY_TRANSFER_LIMIT_KOBO=
